{
  "manifest_version": 3,
  "name": "Onde Caçar: ajudante não oficial do PokeIdle",
  "short_name": "Onde Caçar",
  "version": "2.3.1",
  "description": "Ajudante não oficial do PokeIdle: melhores hunts para o seu pokémon, poção e pokébola certas, sessão ao vivo, progresso e avisos.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pokeidle.io/*"
      ],
      "js": [
        "src/01-hook.js",
        "src/02-jogo.js",
        "src/03-motor.js",
        "src/04-sessao.js",
        "src/05-ui.js",
        "src/06-auto.js",
        "src/07-avisos.js",
        "src/08-debug.js"
      ],
      "css": [
        "src/ui.css"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "author": "Comunidade Onde Caçar"
}